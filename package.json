{
  "name": "pot-pet",
  "version": "0.3.0",
  "description": "바탕화면에서 키우는 도트 화분 펫",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tools/test-logic.js",
    "preview": "node tools/preview.js",
    "assets": "node tools/make-assets.js"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "com.example.potpet",
    "productName": "화분 펫",
    "files": [
      "main.js",
      "preload.js",
      "preload-note.js",
      "preload-toy.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    }
  }
}
